// DHealth Firestore Security Rules
// Last updated: 2026-09-10
// Pilot version — reviewed before scaling beyond 50 patients
// Sprint update: added medicationProfile, weeklyFocus,
//   proAlertDismissals; fixed doctor read on user document;
//   removed dead routineCompletions rule; tightened
//   _health_check and sharedWithDoctors status validation.
// Clinical evidence review: clinicalEvidenceReviews +
//   clinicalEvidenceEmergencyActions; profile.role lock so clients
//   cannot self-grant clinicalReviewer / clinicalAdmin.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Sanitize email for doc path (must match Dart DoctorPatientLinkService._sanitizeEmailForPath:
    // email.toLowerCase().replaceAll('.', '_').replaceAll('@', '_at_')).
    // BOTH split() and replace() take a regular expression, not a literal separator.
    // split('.') therefore splits on every character ('.' = "any char" in regex),
    // so the result never equals the path ID and every doctor list/get is denied.
    // '\\.' is the regex for a literal '.' — same as Dart's replaceAll('.', '_').
    function sanitizedDoctorEmail() {
      return request.auth.token.email.lower().split('\\.').join('_').split('@').join('_at_');
    }

    // Doctor can read patient data if an active sharedWithDoctors link exists
    // App uses users/{patientId}/sharedWithDoctors/{sanitizedDoctorEmail}, not top-level doctorPatientLinks
    function isDoctorLinkedToPatient(patientUid) {
      return exists(/databases/$(database)/documents/users/$(patientUid)/sharedWithDoctors/$(sanitizedDoctorEmail()))
        && get(/databases/$(database)/documents/users/$(patientUid)/sharedWithDoctors/$(sanitizedDoctorEmail())).data.status == 'active';
    }

    function signedInRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profile', {}).get('role', 'patient')
        : 'patient';
    }

    function isClinicalStaff() {
      return isSignedIn() && signedInRole() in ['clinicalReviewer', 'clinicalAdmin'];
    }

    function isClinicalAdmin() {
      return isSignedIn() && signedInRole() == 'clinicalAdmin';
    }

    function isClientRole(role) {
      return role in ['patient', 'doctor'];
    }

    function incomingProfileRole() {
      return request.resource.data.get('profile', {}).get('role', 'patient');
    }

    function storedProfileRole() {
      return resource.data.get('profile', {}).get('role', 'patient');
    }

    function roleUpdateAllowed() {
      return incomingProfileRole() == storedProfileRole()
        || (isClientRole(incomingProfileRole()) && isClientRole(storedProfileRole()));
    }

    function isValidEntryRef(ref) {
      return ref is map
        && ref.condition is string && ref.condition.size() > 0
        && ref.location is string && ref.location.size() > 0;
    }

    function isValidProposedContent(content) {
      return content is map
        && content.title is string
        && content.authors is string
        && content.doi is string
        && content.keyFinding is string;
    }

    function reviewCreateValid() {
      return request.resource.data.status == 'pending'
        && isValidEntryRef(request.resource.data.entryRef)
        && isValidProposedContent(request.resource.data.proposedContent)
        && request.resource.data.submittedBy is string
        && request.resource.data.submittedBy.size() > 0
        && request.resource.data.submittedAt == request.time
        && (!('reviewedBy' in request.resource.data)
          || request.resource.data.reviewedBy == null)
        && (!('reviewedAt' in request.resource.data)
          || request.resource.data.reviewedAt == null)
        && (!('gradeLevel' in request.resource.data)
          || request.resource.data.gradeLevel == null);
    }

    function reviewImmutableFieldsUnchanged() {
      return request.resource.data.entryRef == resource.data.entryRef
        && request.resource.data.proposedContent == resource.data.proposedContent
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.submittedAt == resource.data.submittedAt
        && (
          (!('previousContent' in resource.data)
            && !('previousContent' in request.resource.data))
          || request.resource.data.previousContent == resource.data.previousContent
        );
    }

    function reviewUpdateValid() {
      return resource.data.status == 'pending'
        && request.resource.data.status in ['pending', 'approved', 'rejected', 'needs_changes']
        && reviewImmutableFieldsUnchanged()
        && (
          request.resource.data.status == 'pending'
          || (
            request.resource.data.reviewedBy is string
            && request.resource.data.reviewedBy.size() > 0
            && request.resource.data.reviewedAt == request.time
          )
        )
        && (
          request.resource.data.status != 'approved'
          || (request.resource.data.gradeLevel is string
            && request.resource.data.gradeLevel.size() > 0)
        );
    }

    function emergencyCreateValid() {
      return request.resource.data.action in ['disable', 'restore']
        && isValidEntryRef(request.resource.data.entryRef)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.actionBy is string
        && request.resource.data.actionBy.size() > 0
        && request.resource.data.actionAt == request.time
        && request.resource.data.resolveBy is timestamp
        && (!('resolution' in request.resource.data)
          || request.resource.data.resolution == null)
        && (!('resolvedBy' in request.resource.data)
          || request.resource.data.resolvedBy == null)
        && (!('resolvedAt' in request.resource.data)
          || request.resource.data.resolvedAt == null);
    }

    function emergencyUpdateValid() {
      return (!('resolution' in resource.data) || resource.data.resolution == null)
        && request.resource.data.resolution in ['revoked-permanently', 'restored']
        && request.resource.data.resolvedBy is string
        && request.resource.data.resolvedBy.size() > 0
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.action == resource.data.action
        && request.resource.data.entryRef == resource.data.entryRef
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.actionBy == resource.data.actionBy
        && request.resource.data.actionAt == resource.data.actionAt
        && request.resource.data.resolveBy == resource.data.resolveBy;
    }

    // ── HEALTH CHECK (connectivity probe) ────────────────────────────
    match /_health_check/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── USER PROFILE ────────────────────────────────────────────────
    // Clients may only set profile.role to patient|doctor. Protected roles
    // (clinicalReviewer, clinicalAdmin) are console / Admin SDK only.
    match /users/{uid} {
      allow read:  if isSignedIn() && (isOwner(uid) || isDoctorLinkedToPatient(uid));
      allow create: if isSignedIn() && isOwner(uid)
        && isClientRole(incomingProfileRole());
      allow update: if isSignedIn() && isOwner(uid) && roleUpdateAllowed();
      allow delete: if false;
    }

    // ── PATIENT DATA (subcollections) ───────────────────────────────
    // Patient: full read/write. Linked doctor: read-only.
    // Note: doctors can never write patient data; writes are restricted to owners only.
    match /users/{uid}/dailyLogs/{logId} {
      allow read:  if isSignedIn() && (isOwner(uid) || isDoctorLinkedToPatient(uid));
      allow write: if isSignedIn() && isOwner(uid);
    }

    match /users/{uid}/weeklyPulses/{pulseId} {
      allow read:  if isSignedIn() && (isOwner(uid) || isDoctorLinkedToPatient(uid));
      allow write: if isSignedIn() && isOwner(uid);
    }

    match /users/{uid}/proAssessments/{assessmentId} {
      allow read:  if isSignedIn() && (isOwner(uid) || isDoctorLinkedToPatient(uid));
      allow write: if isSignedIn() && isOwner(uid);
    }

    // Medication profile — patient write, doctor read
    match /users/{uid}/medicationProfile/{docId} {
      allow read:  if isSignedIn() && (isOwner(uid) || isDoctorLinkedToPatient(uid));
      allow write: if isSignedIn() && isOwner(uid);
    }

    // Medication exceptions (missed dose / stop / change) — patient write, doctor read
    match /users/{uid}/medicationExceptions/{docId} {
      allow read:  if isSignedIn() && (isOwner(uid) || isDoctorLinkedToPatient(uid));
      allow write: if isSignedIn() && isOwner(uid);
    }

    // Weekly focus — patient write, doctor read (DoctorPortalDataService + reports)
    match /users/{uid}/weeklyFocus/{docId} {
      allow read:  if isSignedIn() && (isOwner(uid) || isDoctorLinkedToPatient(uid));
      allow write: if isSignedIn() && isOwner(uid);
    }

    // PRO alert dismissals — patient only
    match /users/{uid}/alertDismissals/{docId} {
      allow read, write: if isSignedIn() && isOwner(uid);
    }

    match /users/{uid}/reports/{reportId} {
      allow read:  if isSignedIn() && (isOwner(uid) || isDoctorLinkedToPatient(uid));
      allow write: if isSignedIn() && isOwner(uid);
    }

    // Wearable data — patient only (doctors see derived summaries in PDF, not raw)
    match /users/{uid}/wearableSources/{sourceId} {
      allow read, write: if isSignedIn() && isOwner(uid);
    }

    match /users/{uid}/dailyWearableAggregates/{date} {
      allow read, write: if isSignedIn() && isOwner(uid);
    }

    match /users/{uid}/syncAuditLog/{recordId} {
      allow read, write: if isSignedIn() && isOwner(uid);
    }

    match /users/{uid}/redFlagAcknowledgements/{docId} {
      allow read, write: if isSignedIn() && isOwner(uid);
    }

    // Confirmed flare events — patient write, doctor read (report generation)
    match /users/{uid}/flareEvents/{eventId} {
      allow read:  if isSignedIn() && (isOwner(uid) || isDoctorLinkedToPatient(uid));
      allow write: if isSignedIn() && isOwner(uid);
    }

    // In-app flare detection candidates — patient only (doctors see flareEvents)
    match /users/{uid}/flareCandidates/{candidateId} {
      allow read, write: if isSignedIn() && isOwner(uid);
    }

    // ── DOCTOR–PATIENT LINKS (sharedWithDoctors) ────────────────────
    // Doc ID: sanitized doctor email (e.g. doc_at_example_com)
    // Patient creates/updates/deletes; doctor reads own doc for verification
    match /users/{uid}/sharedWithDoctors/{docId} {
      allow create: if isSignedIn() && isOwner(uid)
        && request.resource.data.status in ['active', 'revoked', 'pending'];
      allow update: if isSignedIn() && isOwner(uid)
        && request.resource.data.status in ['active', 'revoked', 'pending'];
      allow read:   if isSignedIn() && (isOwner(uid) || docId == sanitizedDoctorEmail());
      allow delete: if isSignedIn() && isOwner(uid);

      // Doctor records view timestamp when they have active access
      match /doctorSession/{sessionId} {
        allow read: if isSignedIn() && (isOwner(uid) || docId == sanitizedDoctorEmail());
        allow create, update: if isSignedIn()
          && docId == sanitizedDoctorEmail()
          && get(/databases/$(database)/documents/users/$(uid)/sharedWithDoctors/$(docId)).data.status == 'active';
        allow delete: if false;
      }

      // Clinical messaging: patient and doctor read/write when link is active.
      // Create also requires content to be a string of at most 2000 characters
      // (matches ClinicalMessage.maxContentLength).
      match /clinicalMessages/{messageId} {
        allow read: if isSignedIn()
          && (isOwner(uid) || docId == sanitizedDoctorEmail())
          && get(/databases/$(database)/documents/users/$(uid)/sharedWithDoctors/$(docId)).data.status == 'active';
        allow create: if isSignedIn()
          && (isOwner(uid) || docId == sanitizedDoctorEmail())
          && get(/databases/$(database)/documents/users/$(uid)/sharedWithDoctors/$(docId)).data.status == 'active'
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ── DOCTOR-QUERYABLE LINK INDEX (doctorLinks) ────────────────────
    // Doc ID: sanitized doctor email. Subcollection doc ID: patientId.
    // A parallel, doctor-side-queryable index of the same relationship
    // recorded in users/{uid}/sharedWithDoctors — kept in sync by
    // DoctorPatientLinkService.createLink/revokeLink via batched writes.
    // Exists because a collectionGroup query with FieldPath.documentId()
    // requires a full document path, so a doctor cannot query across every
    // patient's sharedWithDoctors subcollection that way. Querying this
    // top-level collection directly has no such restriction.
    match /doctorLinks/{sanitizedEmail}/patients/{patientId} {
        // Doctor reads their own index (parent doc ID == their sanitized email).
        allow read: if isSignedIn() && sanitizedEmail == sanitizedDoctorEmail();

        // Only the patient who owns this record may create/update their
        // index entry, and only with a status that mirrors what's allowed
        // on the source-of-truth link. (Not gated on exists() of the
        // sibling sharedWithDoctors doc: both are written in the same
        // batch by createLink, and rule evaluation for a batched write
        // only sees database state from before the batch commits, so an
        // exists() check here would always fail during creation.)
        allow create, update: if isSignedIn() && isOwner(patientId)
          && request.resource.data.status in ['active', 'revoked', 'pending'];
        allow delete: if isSignedIn() && isOwner(patientId);
    }

    // ── CLINICAL EVIDENCE REVIEW (compliance gate) ──────────────────
    // Any authenticated user may *submit* a pending review. Only
    // clinicalReviewer / clinicalAdmin may read the queue or change
    // status. Nobody can create a document already marked approved, or
    // set reviewedBy on create. Approved / rejected / needs_changes
    // records are immutable (audit trail). Deletes are denied.
    match /clinicalEvidenceReviews/{reviewId} {
      allow read: if isClinicalStaff();
      allow create: if isSignedIn() && reviewCreateValid();
      allow update: if isClinicalStaff() && reviewUpdateValid();
      allow delete: if false;
    }

    // Emergency disable / restore of an already-approved live entry.
    // clinicalAdmin only. Open disables must be resolved (restored or
    // revoked-permanently) by a human; rules do not auto-revert.
    match /clinicalEvidenceEmergencyActions/{actionId} {
      allow read: if isClinicalStaff();
      allow create: if isClinicalAdmin() && emergencyCreateValid();
      allow update: if isClinicalAdmin() && emergencyUpdateValid();
      allow delete: if false;
    }

    // ── DENY ALL ELSE ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
