rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // split('[.]') — character class matching a literal '.'
    match /doctorLinks/{sanitizedEmail}/patients/{patientId} {
      allow read: if isSignedIn()
        && sanitizedEmail == request.auth.token.email.split('[.]').join('_').split('@').join('_at_');
    }
  }
}
